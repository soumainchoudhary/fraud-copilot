# Fraud Copilot Environment Variables
# Copy this file to .env and fill in the values.

# --- Gemini API (for RAG generation) ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Model Configuration ---
MODEL_PATH=models/xgboost_fraud_v1.joblib
MODEL_VERSION=xgboost-v1
FLAG_THRESHOLD=0.5

# --- Gemini Model ---
GEMINI_MODEL=gemini-3.8-flash

# --- ChromaDB ---
CHROMA_PERSIST_DIR=data/chroma_db

# --- Security Configuration ---
# API_KEY: Set a secure key to enforce authentication on /score, /ask, /cases
API_KEY=
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120
ASK_RATE_LIMIT_PER_MINUTE=30

# --- Logging ---
LOG_LEVEL=INFO
